# Copy to .env.local and fill in. Each commit that needs a variable adds it here.

# Neon Postgres. Written into the Vercel project by the Neon integration;
# `vercel env pull .env.local` copies them here. UNPOOLED is used by drizzle-kit.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk. From dashboard.clerk.com, the Mira application, API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Seed. Email of the Clerk account that owns the demo data (npm run db:seed).
SEED_EMAIL=
