# Copy to .env.local and fill in. Each commit that needs a variable adds it here.

# Neon Postgres. Written into the Vercel project by the Neon integration;
# `vercel env pull .env.local` copies them here. UNPOOLED is used by drizzle-kit.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk. From dashboard.clerk.com, the Mira application, API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Seed. Email of the Clerk account that owns the demo data (npm run db:seed).
SEED_EMAIL=

# Stripe. Secret key from the sandbox at dashboard.stripe.com (Developers,
# API keys). The webhook secret is NOT the same locally and in production:
# production comes from the endpoint in the dashboard, local comes from
# whatever `stripe listen` prints when you start it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Where Stripe sends people back to after Checkout and the billing portal.
# Local: http://localhost:3000 (or whichever port `npm run dev` picked).
# Vercel sets VERCEL_PROJECT_PRODUCTION_URL, which is used when this is unset.
NEXT_PUBLIC_APP_URL=

# Stripe pricing table trial (evaluation only, see /pricing/table).
# The publishable key is public by design; it ships in client HTML.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PRICING_TABLE_ID=
